{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": ">=24"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "overrides": {
    "sharp": "0.35.5"
  },
  "scripts": {
    "build": "npm run build.client && npm run build.server && npm run lint && npm run build.types",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist/AE3-Portfolio-Cloud-DevOps && vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "build:pages": "npm run build.client && npm run build.server",
    "seo:llms": "node scripts/generate-llms.mjs",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "optimize:images": "node scripts/optimize-images.js",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@eslint/js": "latest",
    "@qwik-ui/headless": "^0.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-plugin-qwik": "^1.20.1",
    "globals": "17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
